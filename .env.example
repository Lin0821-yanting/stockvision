# StockVision 環境變數範本
# 使用方式：在專案根目錄複製成 .env（copy .env.example .env），再填入自己的值。
# .env 已列入 .gitignore，不會上傳到 GitHub。請勿把 Token 寫進程式碼或貼到公開的地方。

# --- 股票資料 API ---
# FinMind token（選填）：未填時每小時 300 次；到 https://finmindtrade.com/ 註冊並驗證信箱後可提高到 600 次
FINMIND_TOKEN=
# Finnhub API Key（選填）：美股盤中報價。未填時美股改用 FinMind 每日收盤資料
# 免費註冊：https://finnhub.io/register
FINNHUB_API_KEY=

# --- 後端設定 ---
# SQLite 位置（相對路徑以 backend/ 為基準）
DATABASE_URL=sqlite:///./data/stockvision.db
# 允許呼叫 API 的前端網址（逗號分隔）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 價格提醒背景排程：後端運行期間，只在交易時段實際檢查
ALERT_SCHEDULER_ENABLED=true
ALERT_CHECK_INTERVAL_SECONDS=60

# --- 登入 ---
# 登入有效天數
SESSION_DAYS=7
# 部署到 HTTPS 時改成 true（cookie 只經由 HTTPS 傳送）；本機 http://localhost 開發維持 false
SESSION_COOKIE_SECURE=false
# 是否開放註冊新帳號
REGISTRATION_ENABLED=true

# --- 大盤總覽 ---
# 每個市場列出的公司數量（4–30）
OVERVIEW_SIZE=12

# --- 前端設定 ---
# Next.js 只讀 frontend/ 底下的 .env.local；預設會呼叫「和網頁相同主機名稱的 :8000」，一般不需要設定。
# 若要設定，請用相同的主機名稱開啟網站（例如都用 localhost），登入 cookie 才送得出去。
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
